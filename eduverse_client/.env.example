# ==========================================================
# EduVerse Frontend - Biến môi trường mẫu (.env.example)
# Sao chép file này thành .env.local rồi điền giá trị thật.
# KHÔNG commit .env.local (đã được .gitignore bỏ qua).
# ==========================================================

# URL của backend API (KHÔNG có dấu "/" ở cuối)
NEXT_PUBLIC_API_URL=http://localhost:5002

# Google OAuth 2.0 Client ID (loại "Web application")
# Lấy tại: Google Cloud Console -> APIs & Services -> Credentials
# Giá trị này PHẢI TRÙNG với Authentication:Google:ClientId ở backend (appsettings).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# (Tùy chọn) Facebook App ID nếu dùng đăng nhập Facebook
NEXT_PUBLIC_FACEBOOK_APP_ID=
